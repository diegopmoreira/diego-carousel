{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "$schema": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{3,63}$"
          },
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "type": "string",
            "enum": [
              "user",
              "library",
              "video_frame",
              "licensed",
              "generated",
              "external"
            ]
          },
          "rights": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "request": {},
          "prompt": {
            "type": "string"
          },
          "negative": {
            "type": "string"
          },
          "seed": {
            "type": [
              "number",
              "string"
            ]
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{3,63}$"
          },
          "source_url": {
            "type": "string"
          },
          "focal_point": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "rationale": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "credit": {
            "default": "",
            "type": "string"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "used_by": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{3,63}$"
            }
          }
        },
        "required": [
          "id",
          "file",
          "sha256",
          "origin",
          "rights",
          "provider",
          "created_at",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "assets"
  ],
  "additionalProperties": false
}
