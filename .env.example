# Nenhuma credencial necessária para importação, render e export local.
# Higgsfield utiliza OAuth via MCP; nunca colocar segredos no repositório.

# Imagens de fundo do TMDB (asset search/pick). Chave gratuita da conta de Diego:
# themoviedb.org → Configurações → API. Aceita a chave v3 ou o token de leitura v4.
# Copiar este arquivo para .env (ignorado pelo git) e preencher.
TMDB_API_KEY=
